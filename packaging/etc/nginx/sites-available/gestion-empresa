server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/gestion-empresa;
    index gestion-empresa.html;

    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";

        set $block_auth "";
        if ($remote_addr = 127.0.0.1) { set $block_auth "local"; }
        if ($remote_addr = ::1) { set $block_auth "local"; }
        if ($block_auth = "") {
            auth_basic "Gestion Empresa";
            auth_basic_user_file /etc/gestion-empresa/.htpasswd;
        }
        try_files $uri $uri/ /gestion-empresa.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8081/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
