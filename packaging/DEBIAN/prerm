#!/bin/sh
# Gestion Empresa - prerm
# Copyright (C) 2026 JMBernabeu - GPL-3.0-or-later
set -e

case "$1" in
  remove|purge|upgrade|deconfigure)
    systemctl stop gestion-empresa.service >/dev/null 2>&1 || true
    rm -f /etc/nginx/sites-enabled/gestion-empresa
    if command -v nginx >/dev/null 2>&1; then
      nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
