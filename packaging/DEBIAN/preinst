set -e

# Garantizar los directorios antes de que dpkg desempaquete los ficheros
# (necesario en sistemas sin /var/www).
mkdir -p /var/www/gestion-empresa
mkdir -p /var/lib/gestion-empresa
mkdir -p /usr/lib/gestion-empresa
mkdir -p /usr/share/doc/gestion-empresa

exit 0
