[Unit]
Description=Medicion Obra - Servidor integrado (web + API SQLite)
Documentation=https://github.com/JMBermejias/medicion-obra
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=WEB_DIR=/var/www/medicion-obra
Environment=DB_PATH=/var/lib/medicion-obra/medicion.db
Environment=AUTH_FILE=/var/lib/medicion-obra/auth.json
Environment=PORT=8080
ExecStart=/usr/bin/python3 /usr/lib/medicion-obra/server.py
WorkingDirectory=/usr/lib/medicion-obra
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
