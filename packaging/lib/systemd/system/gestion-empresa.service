[Unit]
Description=Gestion Empresa - Servidor integrado (web + API SQLite)
Documentation=https://github.com/JMBermejias/gestionempresa
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=WEB_DIR=/var/www/gestion-empresa
Environment=DB_PATH=/var/lib/gestion-empresa/medicion.db
Environment=AUTH_FILE=/var/lib/gestion-empresa/auth.json
Environment=PORT=8081
ExecStart=/usr/bin/python3 /usr/lib/gestion-empresa/server.py
WorkingDirectory=/usr/lib/gestion-empresa
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
